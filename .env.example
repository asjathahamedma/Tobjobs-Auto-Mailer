# PostgreSQL and Redis for the Docker Compose development stack
POSTGRES_PASSWORD=topjobs_dev_only
DATABASE_URL=postgresql+psycopg://topjobs:topjobs_dev_only@localhost:5432/topjobs
REDIS_URL=redis://localhost:6379/0

# Public Next.js settings; values are embedded into the frontend build
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Current FastAPI service settings. Server-side secrets must never use NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
APP_CREDENTIALS_ENCRYPTION_KEY=generate-a-fernet-key
WEB_ALLOWED_ORIGINS=http://localhost:3000
SEARCH_QUEUE_BACKEND=local
VERCEL_QUEUE_REGION=iad1
